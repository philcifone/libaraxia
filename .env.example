# Application Configuration
SECRET_KEY=CHANGE-ME-y0uR-S3cr3t-K3y-CHANGE-ME
GOOGLE_BOOKS_API_KEY=get_yours_at_https://console.cloud.google.com
FLASK_ENV=development

# Optional: film details for the Add Video lookup (director, runtime, synopsis,
# poster). Free at https://www.themoviedb.org/settings/api ; either the
# "API Read Access Token" (preferred: sent as a header, never in a URL) or the
# v3 "API Key". Without it, lookups use UPCitemdb only (no key needed).
# TMDB_API_KEY=

# Optional: Discogs personal access token (discogs.com/settings/developers ->
# Generate new token) for Add Album's search. Without it, MusicBrainz only.
# DISCOGS_TOKEN=
# Optional: collection values (docs/PHOTOS-VALUE-SPEC.md, section 7).
# Records are valued by Discogs with the DISCOGS_TOKEN above, once the token
# owner's Seller Settings are filled in on discogs.com. Books and movies by
# the eBay Browse API: a Production keyset from developer.ebay.com (App ID and
# Cert ID). Without these, values are typed in by hand. One currency for the
# site; a fetched price in another currency is refused, not converted.
# VALUE_CURRENCY=USD
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE=EBAY_US
# Optional: Audiobookshelf (docs/AUDIOBOOKSHELF-SPEC.md). One server for the
# site; each user pastes their own API key in Settings (stored encrypted
# under SECRET_KEY, so changing SECRET_KEY means everyone reconnects).
# AUDIOBOOKSHELF_URL is what this server calls: use the LAN address
# (http://192.168.1.x:13378), not a tunnel. AUDIOBOOKSHELF_PUBLIC_URL is
# only for "Open in Audiobookshelf" links in the browser (a tunnel, for a
# phone away from home); it defaults to the URL above. Without a URL the
# feature is hidden.
# AUDIOBOOKSHELF_URL=
# AUDIOBOOKSHELF_PUBLIC_URL=
# Contact for the MusicBrainz User-Agent; an email is best.
# MUSICBRAINZ_CONTACT=

# Database file (default: library.db in the project directory; a relative
# path is relative to the project directory, not the working directory)
# DATABASE_PATH=library.db

# Site backups (Admin > Backups). Default: backups/ beside the database. Same
# filesystem as static/uploads keeps covers as hard links instead of copies.
# BACKUP_DIR=/var/lib/libaraxia/backups

# Close self-registration once your accounts exist (the first account can always register)
ALLOW_REGISTRATION=True

# Number of reverse proxies in front of the app (nginx, cloudflared...), so rate
# limits and logs see the real client IP. 0 = not behind a proxy.
TRUSTED_PROXY_COUNT=0

# Email Verification Configuration
# Set to True to require email verification for new users
EMAIL_VERIFICATION_REQUIRED=False

# Email Server Configuration (Required if EMAIL_VERIFICATION_REQUIRED=True)
# Gmail Example:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Other Email Providers:
# SendGrid:
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key

# Mailgun:
# MAIL_SERVER=smtp.mailgun.org
# MAIL_USERNAME=postmaster@your-domain.mailgun.org
# MAIL_PASSWORD=your-mailgun-password

# AWS SES:
# MAIL_SERVER=email-smtp.us-east-1.amazonaws.com
# MAIL_USERNAME=your-ses-smtp-username
# MAIL_PASSWORD=your-ses-smtp-password
